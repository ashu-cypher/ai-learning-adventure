# AI Learning Adventure Environment Variables
PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite+aiosqlite:///./learning_adventure.db

# AI Provider settings: 'gemini', 'openai', or 'smart_rules' (default: smart_rules works out of the box offline with zero keys)
AI_PROVIDER=smart_rules

# Optional LLM API keys if switching from smart_rules to live LLM
GEMINI_API_KEY=
OPENAI_API_KEY=
